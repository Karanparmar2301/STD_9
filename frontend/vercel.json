{
	"rewrites": [
		{
			"source": "/api/(.*)",
			"destination": "https://student-dashboard-backend.onrender.com/api/$1"
		},
		{
			"source": "/auth/(.*)",
			"destination": "https://student-dashboard-backend.onrender.com/auth/$1"
		},
		{
			"source": "/chat",
			"destination": "https://student-dashboard-backend.onrender.com/chat"
		},
		{
			"source": "/uploads/(.*)",
			"destination": "https://student-dashboard-backend.onrender.com/uploads/$1"
		},
		{
			"source": "/(.*)",
			"destination": "/index.html"
		}
	]
}